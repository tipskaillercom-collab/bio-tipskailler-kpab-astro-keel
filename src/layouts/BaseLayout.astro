---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import '../styles/global-overrides.css';
import '../styles/global-extended.css';
import '../styles/global-addons.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { SITE, NAV_ITEMS } from '../consts';
import { locales, locale as defaultLocale, useTranslations, type Locale } from '../i18n';
import CodeCopy from '../components/CodeCopy.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { createI18nHelper } from '../lib/client-locale';

// Khởi tạo helper ở phía server để chuẩn bị chuyển đổi định dạng
const serverI18nHelper = createI18nHelper();
const NS_ClientI18nHelper = '__clientI18nHelpers';

// Ép toàn bộ logic các hàm thành chuỗi văn bản (String) để gán vào đối tượng toàn cục `window` trên trình duyệt
const clientI18nHelpers = `
  window.${NS_ClientI18nHelper} = window.${NS_ClientI18nHelper} || {};

  window.${NS_ClientI18nHelper}.getSegments = ${serverI18nHelper.getSegments.toString()};
  window.${NS_ClientI18nHelper}.isValidLocale = ${serverI18nHelper.isValidLocale.toString()};
  window.${NS_ClientI18nHelper}.getCurrentLocale = ${serverI18nHelper.getCurrentLocale.toString()};
  window.${NS_ClientI18nHelper}.cleanSegments = ${serverI18nHelper.cleanSegments.toString()};
  window.${NS_ClientI18nHelper}.buildPath = ${serverI18nHelper.buildPath.toString()};
`;

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

// Lấy locale từ Astro.params, fallback về defaultLocale
const locale = (Astro.params.locale ?? defaultLocale) as Locale;
// Sử dụng useTranslations với locale của trang hiện tại
const { navLabel, t } = useTranslations(locale);

const siteName = SITE.title;

const { title = siteName, description = SITE.description, ogType = 'website', image } = Astro.props;

// `Astro.site` comes from `site` in astro.config.mjs; fall back to the
// request URL during dev so canonical/OG links still resolve.
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
    <title>{fullTitle}</title>

    {/* Astro comment syntax — an HTML comment here would ship on every page. */}
    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {/* Open Graph wants `ja_JP`, not the `ja-JP` of `<html lang>`. */}
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    {/* Twitter */}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      // Runs before paint on the initial load, and again on `astro:after-swap`
      // because the router resets `<html>` attributes during soft navigation.
      // IIFE so top-level consts can't clash if the script ever re-runs.
      (() => {
        const applyTheme = () => {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = storedTheme || (prefersDark ? 'dark' : 'light');
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- Đưa bộ thư viện helper dạng chuỗi vào môi trường runtime của trình duyệt -->
    <script is:inline set:html={clientI18nHelpers} />
    <!-- Script chặn render sai ngôn ngữ ngay trước khi trình duyệt vẽ giao diện (Anti-Flicker) -->
    <script
      is:inline
      define:vars={{
        NS_ClientI18nHelper: NS_ClientI18nHelper,
        locales: locales,
        defaultLocale: defaultLocale, // Được truyền trực tiếp từ biến `locale` (SITE.locale) của file i18n/index.ts. `NOTE`: Nó khác với `locale` hiện tại của trang
      }}
    >
      (() => {
        const applyLocale = () => {
          // Lấy bộ công cụ helper từ đối tượng window toàn cục
          const clientI18nHelpers = window[NS_ClientI18nHelper];
          if (!clientI18nHelpers) return;

          // Thực hiện phân rã các thông số URL hiện tại
          const segments = clientI18nHelpers.getSegments();
          const storedLocale = localStorage.getItem('locale');

          // Kiểm tra xem phân đoạn đầu tiên của URL có phải là mã ngôn ngữ hợp lệ hay không
          const isValidLocaleResult = clientI18nHelpers.isValidLocale(segments[0], locales);

          // Lấy ra ngôn ngữ thực tế của URL (nếu URL không có tiền tố, hàm trả về defaultLocale)
          const currentUrlLocale = clientI18nHelpers.getCurrentLocale(
            segments,
            isValidLocaleResult,
            defaultLocale,
          );

          // TRƯỜNG HỢP ĐẶC BIỆT (Yêu cầu cốt lõi): URL chứa mã ngôn ngữ trùng với ngôn ngữ hệ thống mặc định
          // Ví dụ: Cấu hình hệ thống mặc định là "ja" nhưng URL lại là ://domain.com
          if (isValidLocaleResult && segments[0] === defaultLocale) {
            // Đồng bộ lại bộ nhớ hệ thống về ngôn ngữ mặc định này
            localStorage.setItem('locale', defaultLocale);

            // Bóc tách chữ tiền tố thừa đó ra (Ví dụ: bỏ "ja" ra khỏi ["ja", "about"] thành ["about"])
            const cleanSegmentsResult = clientI18nHelpers.cleanSegments(segments, true);

            // Tạo dựng URL sạch không chứa tiền tố trùng lặp mặc định
            const cleanUrl = clientI18nHelpers.buildPath(
              defaultLocale,
              cleanSegmentsResult,
              defaultLocale,
            );

            // Điều hướng ngay lập tức về trang sạch chuẩn SEO (://domain.com) và dừng tiến trình
            window.location.href = cleanUrl;
            return;
          }

          // Bước 1: Xác định ngôn ngữ mục tiêu người dùng mong muốn dựa trên độ ưu tiên
          // Thứ tự: Lựa chọn lưu trữ trước đó (localStorage) -> Ngôn ngữ máy của trình duyệt -> Mặc định hệ thống
          let targetLocale = defaultLocale;
          if (storedLocale && locales.includes(storedLocale)) {
            targetLocale = storedLocale;
          } else {
            const browserLang = (navigator.language || navigator.userLanguage || '').split('-')[0];
            if (locales.includes(browserLang)) {
              targetLocale = browserLang;
            }
          }

          // Bước 2: Kiểm tra sự lệch pha giữa ngôn ngữ đích và ngôn ngữ hiển thị trên URL hiện tại
          if (targetLocale !== currentUrlLocale) {
            // Cập nhật bộ nhớ hệ thống theo ngôn ngữ đích mới
            localStorage.setItem('locale', targetLocale);

            // Tiến hành làm sạch mảng phân đoạn URL cũ
            const cleanSegmentsResult = clientI18nHelpers.cleanSegments(
              segments,
              isValidLocaleResult,
            );

            // Tạo dựng URL đích mới phù hợp với cấu hình (Nếu bằng defaultLocale sẽ tự động giấu đi)
            const finalUrl = clientI18nHelpers.buildPath(
              targetLocale,
              cleanSegmentsResult,
              defaultLocale,
            );

            // Điều hướng sang trang đích và dừng tiến trình để chờ tải trang mới
            window.location.href = finalUrl;
            return;
          }

          // Nếu URL đã trùng khớp hoàn hảo với ngôn ngữ đích, đồng bộ giá trị chuẩn vào bộ nhớ lưu trữ
          localStorage.setItem('locale', currentUrlLocale);

          // Đính thuộc tính dữ liệu data-locale vào thẻ <html> để CSS/JS khác nhận diện điều khiển UI giao diện
          document.documentElement.dataset.locale = currentUrlLocale;
        };

        // Kích hoạt bộ lọc định tuyến ngay khi phân tích cú pháp mã HTML đầu tiên đầu tiên nhằm chặn render sai ngôn ngữ
        applyLocale();

        // Kích hoạt lại bộ lọc mỗi khi hệ thống View Transitions của Astro thực hiện tráo đổi trang (swap)
        document.addEventListener('astro:after-swap', applyLocale);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label={t('nav.brandHome', { site: siteName })}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>{siteName}</span>
      </a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          NAV_ITEMS.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {navLabel(item)}
            </a>
          ))
        }
      </nav>
      <button class="theme-toggle" type="button" aria-label={t('theme.toggle')} data-theme-toggle>
        <span aria-hidden="true"></span>
      </button>

      <button class="locale-toggle" type="button" aria-label="dfsadfdsdafasdf" data-locale-toggle>
        <span aria-hidden="true">sssssssssssssss</span>
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.footerText}</p>
      <div class="footer-links">
        <a href={withBase('/blog/')}>{t('footer.notes')}</a>
        <a href="https://almanac.p4ni.com" target="_blank" rel="noopener noreferrer">Almanac ↗</a>
      </div>
      <SocialLinks locale={locale} />
    </footer>
    <CodeCopy />
    <script>
      // Delegated to `document` so the handler survives view-transition swaps
      // that replace the toggle button element.
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) {
          return;
        }
        const current = document.documentElement.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>

    <script>
      import { createI18nHelper } from '../lib/client-locale';
      import { navigate } from 'astro:transitions/client';
      import { locales, locale as defaultLocale, type Locale } from '../i18n';

      // Gán trực tiếp trình lắng nghe sự kiện click nút đổi ngôn ngữ
      // bằng Event Delegation vào thẻ document toàn cục
      document.addEventListener('click', (event) => {
        // Kiểm tra xem phần tử được click có chứa thuộc tính dữ liệu điều hướng đổi ngôn ngữ [data-locale-toggle] hay không
        if (!(event.target instanceof Element) || !event.target.closest('[data-locale-toggle]')) {
          return; // Nếu không phải nút đổi ngôn ngữ, bỏ qua hành động
        }

        // Khởi tạo bộ công cụ helper i18n đầy đủ tính năng kết hợp cấu hình TypeScript
        // Không cần truyền namespaceName vì client script chạy độc lập bằng bộ biến import tĩnh
        const clientI18nHelpers = createI18nHelper();

        // Đọc dữ liệu URL hiện tại
        const segments = clientI18nHelpers.getSegments();
        const isValidLocaleResult = clientI18nHelpers.isValidLocale(segments[0], locales);
        const currentLocale = clientI18nHelpers.getCurrentLocale(
          segments,
          isValidLocaleResult,
          defaultLocale,
        );

        // Tính toán xoay vòng danh sách ngôn ngữ để tìm ra ngôn ngữ tiếp theo (Ví dụ: en -> ja -> vi -> en)
        const currentIndex = locales.indexOf(currentLocale as Locale);
        const nextLocale: Locale = locales[(currentIndex + 1) % locales.length];

        // Lưu lựa chọn mới của người dùng vào bộ nhớ localStorage
        localStorage.setItem('locale', nextLocale);

        // Xây dựng URL đích mới tinh gọn (giữ nguyên query, hash)
        // Tự giấu tiền tố nếu nextLocale chính là defaultLocale)
        const cleanSegmentsResult = clientI18nHelpers.cleanSegments(segments, isValidLocaleResult);
        const finalUrl = clientI18nHelpers.buildPath(
          nextLocale,
          cleanSegmentsResult,
          defaultLocale,
        );

        // Chuyển trang mượt mà không tải lại toàn bộ tài nguyên nhờ cơ chế nội bộ
        // Single Page App của Astro View Transitions
        navigate(finalUrl);
      });
    </script>
  </body>
</html>
