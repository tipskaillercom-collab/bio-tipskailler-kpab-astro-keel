---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import { SITE } from '../../../consts';
import { useTranslation, locale as defaultLocale } from '../../../i18n';
import { useWithBaseWithLocale } from '../../../lib/url';

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  allTags: string[];
  locale: string;
}

const { page, allTags, locale: propLocale } = Astro.props;

const currentLocale = propLocale ?? Astro.params.locale ?? defaultLocale;
const { t, formatDate, readingTime } = useTranslation(currentLocale);
const { withBase } = useWithBaseWithLocale(currentLocale);

const posts = page.data;

const readingTimes = new Map(
  await Promise.all(
    posts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return [post.id, readingTime(remarkPluginFrontmatter.minutesRead)] as const;
    }),
  ),
);

const pageTitle =
  page.currentPage === 1 ? t('blog.title') : t('blog.titlePaged', { page: page.currentPage });
---

<BaseLayout
  title={pageTitle}
  description={`Notes and writing — ${SITE.title}, a minimal portfolio and blog theme for Astro.`}
>
  <section class="page-head section">
    <p class="eyebrow">{t('blog.eyebrow')}</p>
    <h1>Notes, essays, and release logs.</h1>
    <p class="lead">
      The blog collection supports tags, descriptions, draft filtering, publish dates, and optional
      hero images.
    </p>
  </section>

  <section class="section content-index" aria-label={t('blog.listLabel')}>
    <div class="index-sidebar">
      <p class="eyebrow">{t('blog.tagsEyebrow')}</p>
      <nav class="tag-cloud" aria-label={t('blog.tagsNavLabel')}>
        {allTags.map((tag) => <a href={withBase(`/blog/tags/${tag}/`)}>{tag}</a>)}
      </nav>
    </div>

    <div>
      <div class="entry-list">
        {
          posts.map((post) => (
            <article class="entry-card">
              <div class="entry-meta">
                <time datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate, 'short')}
                </time>
                <span>{readingTimes.get(post.id)}</span>
                <div>
                  {post.data.tags.map((tag, index) => (
                    <>
                      {index > 0 && <span>/</span>}
                      <a href={withBase(`/blog/tags/${tag.toLowerCase()}/`)}>{tag}</a>
                    </>
                  ))}
                </div>
              </div>
              <h2>
                <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
            </article>
          ))
        }
      </div>
      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>
