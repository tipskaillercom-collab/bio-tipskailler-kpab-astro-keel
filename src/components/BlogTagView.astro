---
import { render } from 'astro:content';
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from './Pagination.astro';
import { useWithBaseWithLocale } from '../lib/url';
import { getSiteConfig } from '../consts';
import { type Locale, useTranslations } from '../i18n';
import { toCollectionSlug } from '../helpers/commons';

interface Props {
  locale: Locale;
  tag: string;
  page: Page<CollectionEntry<'blog'>>;
  otherTags: string[];
}

const { locale, tag, page, otherTags } = Astro.props;
const { formatDate, readingTime, t } = useTranslations(locale);
const SITE = getSiteConfig(locale);
const { withBase } = useWithBaseWithLocale(locale);

const taggedPosts = page.data;

const readingTimes = new Map(
  await Promise.all(
    taggedPosts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return [post.id, readingTime(remarkPluginFrontmatter.minutesRead)] as const;
    }),
  ),
);

const pageTitle =
  page.currentPage === 1
    ? t('tag.title', { tag })
    : t('tag.titlePaged', { tag, page: page.currentPage });

const basePrefix = locale === 'en' ? '' : `/${locale}`;

const getPostHref = (postId: string) => {
  const cleanSlug = toCollectionSlug(postId, locale);
  return withBase(`${basePrefix}/blog/${cleanSlug}/`);
};

const getTagHref = (targetTag: string) => {
  return withBase(`${basePrefix}/blog/tags/${targetTag}/`);
};
---

<BaseLayout title={pageTitle} description={t('tag.description', { tag, site: SITE.title })}>
  <section class="page-head section">
    <p class="eyebrow">{t('tag.eyebrow')}</p>
    <h1>{tag}</h1>
    <p class="lead">{t('tag.lead', { tag })}</p>
  </section>

  <section class="section content-index" aria-label={t('tag.listLabel', { tag })}>
    <div class="index-sidebar">
      <p class="eyebrow">{t('tag.moreTagsEyebrow')}</p>
      <nav class="tag-cloud" aria-label={t('tag.otherTagsNavLabel')}>
        <a href={withBase(`${basePrefix}/blog/`)}>{t('tag.allPosts')}</a>
        {otherTags.map((item) => (
          <a href={getTagHref(item)}>{item}</a>
        ))}
      </nav>
    </div>

    <div>
      <div class="entry-list">
        {taggedPosts.map((post) => (
          <article class="entry-card">
            <div class="entry-meta">
              <time datetime={post.data.publishDate.toISOString()}>
                {formatDate(post.data.publishDate, 'short')}
              </time>
              <span>{readingTimes.get(post.id)}</span>
              <span>{post.data.tags.join(' / ')}</span>
            </div>
            <h2>
              <a href={getPostHref(post.id)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>
