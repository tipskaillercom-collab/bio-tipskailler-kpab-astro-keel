---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { DICTIONARIES, DEFAULT_LOCALE, type UIStrings } from '../i18n';
import { SITE } from '../consts';

// Tạo sẵn object chứa toàn bộ bản dịch của 404 để client script sử dụng
const all404Translations = Object.fromEntries(
  Object.entries(DICTIONARIES).map(([lang, dict]) => [
    lang,
    {
      title: dict['notFound.title'],
      description: dict['notFound.description'],
      eyebrow: dict['notFound.eyebrow'],
      heading: dict['notFound.heading'],
      lead: dict['notFound.lead'],
      linksLabel: dict['notFound.linksLabel'],
      home: dict['notFound.home'],
      blog: dict['notFound.blog'],
      works: dict['notFound.works'],
    },
  ]),
);

// Mặc định ban đầu dùng ngôn ngữ hệ thống khi render tĩnh
const defaultDict = DICTIONARIES[DEFAULT_LOCALE];
---

<BaseLayout title={defaultDict['notFound.title']} description={defaultDict['notFound.description']}>
  <section class="hero section">
    <!-- Thêm các thuộc tính data-i18n để JavaScript client tìm và thay thế chữ -->
    <p class="eyebrow" data-i18n="eyebrow">{defaultDict['notFound.eyebrow']}</p>
    <h1 data-i18n="heading">{defaultDict['notFound.heading']}</h1>
    <p class="lead" data-i18n="lead">{defaultDict['notFound.lead']}</p>

    <div
      class="action-row"
      data-i18n-attr="aria-label:linksLabel"
      aria-label={defaultDict['notFound.linksLabel']}
    >
      <a class="button" data-i18n="home" href={withBase('/')}>{defaultDict['notFound.home']}</a>
      <a class="text-link" data-i18n="blog" href={withBase('/blog/')}
        >{defaultDict['notFound.blog']}</a
      >
      <a class="text-link" data-i18n="works" href={withBase('/works/')}
        >{defaultDict['notFound.works']}</a
      >
    </div>
  </section>
</BaseLayout>

<!-- Nhúng thẻ script cấu hình dữ liệu và tự động thay đổi ngôn ngữ ngay khi trang tải -->
<script define:vars={{ all404Translations, DEFAULT_LOCALE }}>
  // 1. Phân tích URL hiện tại trên thanh địa chỉ của trình duyệt
  const pathSegments = window.location.pathname.split('/').filter(Boolean);

  // Kiểm tra xem phân đoạn đầu tiên có trùng với ngôn ngữ nào không (vi, ja, en)
  const currentLang = pathSegments[0] in all404Translations ? pathSegments[0] : DEFAULT_LOCALE;

  if (currentLang !== DEFAULT_LOCALE) {
    const dict = all404Translations[currentLang];

    // Update thẻ tiêu đề và meta của trang
    document.title = dict.title;
    const metaDesc = document.querySelector('meta[name="description"]');
    if (metaDesc) metaDesc.setAttribute('content', dict.description);
    document.documentElement.lang = currentLang;

    // 2. Tìm tất cả các thẻ có đánh dấu dịch thuật để thay chữ nội dung
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (dict[key]) el.textContent = dict[key];
    });

    // 3. Tìm và cập nhật các thuộc tính đặc biệt (như aria-label)
    document.querySelectorAll('[data-i18n-attr]').forEach((el) => {
      const [attrName, key] = el.getAttribute('data-i18n-attr').split(':');
      if (dict[key]) el.setAttribute(attrName, dict[key]);
    });
  }
</script>
