---
import { getCollection } from 'astro:content';
import { alternateLocales } from '../../../i18n';
import RootSlugBlogPage from '../../blog/[slug].astro';
import { toCollectionSlug } from '../../../helpers/commons';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  return alternateLocales.flatMap((alternateLocale) => {
    // 1. Lọc các bài thuộc đúng ngôn ngữ (vd: 'ja/...' hoặc 'vi/...') và sắp xếp mới nhất lên đầu
    const localePosts = allPosts
      .filter((entry) => entry.id.startsWith(`${alternateLocale}/`))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

    // 2. Tạo params & props đầy đủ cho từng bài trong ngôn ngữ đó
    return localePosts.map((entry, index) => {
      const slug = toCollectionSlug(entry.id, alternateLocale);

      const related = localePosts
        .filter((other) => other.id !== entry.id)
        .map((other) => ({
          post: other,
          shared: other.data.tags.filter((tag) => entry.data.tags.includes(tag)).length,
        }))
        .filter(({ shared }) => shared > 0)
        .sort(
          (a, b) =>
            b.shared - a.shared ||
            b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf(),
        )
        .slice(0, 3)
        .map(({ post }) => post);

      return {
        params: {
          locale: alternateLocale,
          slug,
        },
        props: {
          locale: alternateLocale,
          entry,
          slug,
          newer: localePosts[index - 1] ?? null,
          older: localePosts[index + 1] ?? null,
          related,
        },
      };
    });
  });
}

const { locale, entry, slug, newer, older, related } = Astro.props;
---

<RootSlugBlogPage
  locale={locale}
  entry={entry}
  slug={slug}
  newer={newer}
  older={older}
  related={related}
/>
