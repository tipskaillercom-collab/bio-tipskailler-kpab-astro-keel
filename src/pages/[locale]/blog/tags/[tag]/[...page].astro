---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BlogTagView from '../../../../../components/BlogTagView.astro';
import { alternateLocales, type Locale } from '../../../../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );

  return alternateLocales.flatMap((loc) => {
    const localePosts = allPosts.filter((post) => post.id.startsWith(`${loc}/`));
    const allTags = [...new Set(localePosts.flatMap((post) => post.data.tags))];

    return allTags.flatMap((tag) => {
      const taggedPosts = localePosts.filter((post) => post.data.tags.includes(tag));
      const otherTags = allTags.filter((item) => item !== tag).sort((a, b) => a.localeCompare(b));

      return paginate(taggedPosts, {
        params: { locale: loc as Locale, tag },
        pageSize: 10,
        props: { locale: loc as Locale, otherTags },
      });
    });
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.params;
const { page, otherTags, locale } = Astro.props;
---

<BlogTagView locale={locale} tag={tag} page={page} otherTags={otherTags} />
