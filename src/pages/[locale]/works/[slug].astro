---
import { getCollection } from 'astro:content';
import { alternateLocales } from '../../../i18n';
import RootSlugWorkPage from '../../works/[slug].astro';
import { toCollectionSlug } from '../../../helpers/commons';

export async function getStaticPaths() {
  const entries = await getCollection('works');

  return alternateLocales.flatMap((alternateLocale) =>
    entries
      .filter((entry) => entry.id.startsWith(`${alternateLocale}/`))
      .map((entry) => ({
        params: {
          locale: alternateLocale,
          slug: toCollectionSlug(entry.id, alternateLocale),
        },
        props: {
          locale: alternateLocale,
          entry,
        },
      })),
  );
}

const { locale, entry } = Astro.props;
---

<RootSlugWorkPage locale={locale} entry={entry} />
