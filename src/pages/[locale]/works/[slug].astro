// [{ params, props }, { params, props }]
export async function getStaticPaths() {
  const entries = await getCollection('works');

  return alternateLocales.flatMap((alternateLocale) => {
    // Quét qua từng bài viết để lấy ID của slug
    return entries.map((entry) => {
      return {
        params: {
          locale: alternateLocale,
          slug: entry.id,
        },
        props: {
          locale: alternateLocale,
          entry: entry, // Truyền tiếp cục dữ liệu bài viết vào cho file gốc xài
        },
      };
    });
  });
}

const { locale, entry } = Astro.props;
---

<!-- Gọi component RootSlugWorkPage và truyền locale vào qua props -->
<RootSlugWorkPage locale={locale} entry={entry} />
