---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useWithBaseWithLocale } from '../../lib/url';
import { getSiteConfig } from '../../consts';
import { type Locale, locale as defaultLocale, useTranslations } from '../../i18n';
import { toCollectionSlug } from '../../helpers/commons';

// Lấy locale từ Props, fallback về defaultLocale
const locale = (Astro.props.locale ?? defaultLocale) as Locale;

// Sử dụng useTranslations với locale của trang hiện tại
const { t } = useTranslations(locale);
const SITE = getSiteConfig(locale);
const { withBase } = useWithBaseWithLocale(locale);

const works = (await getCollection('works', ({ id }) => id.startsWith(`${locale}/`)))
  .sort((a, b) => {
    const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
    const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
    if (orderA !== orderB) return orderA - orderB;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  })
  .map((work) => ({
    ...work,
    slug: toCollectionSlug(work.id, locale),
  }));
---

<BaseLayout
  title={t('works.title')}
  description={`${t('works.description')} — ${SITE.title}.`}
  ogType="website"
  image={withBase('/og/works/index.png')}
>
  <section class="page-head section">
    <p class="eyebrow">{t('works.eyebrow')}</p>
    <h1>Selected projects and case studies.</h1>
    <p class="lead">
      The works collection is typed for descriptions, technology lists, external links,
      repositories, thumbnails, ordering, and publish dates.
    </p>
  </section>

  <section class="section" aria-label={t('works.listLabel')}>
    <div class="work-list">
      {works.map((work) => (
        <article class="work-card">
          <p class="entry-meta">
            {work.data.tech.map((tech, index) => (
              <>
                {index > 0 && <span>/</span>}
                <a href={withBase(`/tech/${tech.toLowerCase()}/`)}>{tech}</a>
              </>
            ))}
          </p>
          <h2>
            <a href={withBase(`/works/${work.slug}/`)}>{work.data.title}</a>
          </h2>
          <p>{work.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
