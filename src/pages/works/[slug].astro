---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { type Locale, locale as defaultLocale, useTranslations } from '../../i18n';

// 1. Định nghĩa rõ ràng: Props của tôi có thể đến từ trang [locale] HOẶC từ getStaticPaths nội bộ
interface Props {
  locale?: Locale; // Do trang [locale] truyền xuống
  entry: CollectionEntry<'works'>; // Có thể do trang [locale] truyền HOẶC từ getStaticPaths nội bộ sinh ra
}

// 2. Bóc tách trực tiếp một lần duy nhất ở đầu trang
const { entry, locale: passedLocale } = Astro.props as Props;

// 3. Xác định locale chuẩn (Nếu có passedLocale từ trang cha thì xài, không thì dùng mặc định)
const locale = (passedLocale ?? defaultLocale) as Locale;
// Sử dụng useTranslations với locale của trang hiện tại
const { formatDate, t } = useTranslations(locale);

// 4. Hàm sinh đường dẫn tĩnh cho trang gốc
export async function getStaticPaths() {
  const entries = await getCollection('works');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
// export async function getStaticPaths() {
//   const entries = await getCollection('works');
//   return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
// }

// 5. Render nội dung (Biến `entry` lúc này cực kỳ sạch vì đã được bóc tách ở bước 2)
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={withBase(`/og/works/${entry.id}.png`)}
>
  <article data-pagefind-body>
    <header class="page-head section article-head">
      <p class="eyebrow">{t('work.eyebrow')}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="entry-meta">
        <time datetime={entry.data.publishDate.toISOString()}
          >{formatDate(entry.data.publishDate)}</time
        >
        <div>
          {
            entry.data.tech.map((tech, index) => (
              <>
                {index > 0 && <span>/</span>}
                <a href={withBase(`/tech/${tech.toLowerCase()}/`)}>{tech}</a>
              </>
            ))
          }
        </div>
      </div>
      <div class="action-row">
        {
          entry.data.link && (
            <a class="button" href={entry.data.link} target="_blank" rel="noopener noreferrer">
              {t('work.visit')}
            </a>
          )
        }
        {
          entry.data.repo && (
            <a class="text-link" href={entry.data.repo} target="_blank" rel="noopener noreferrer">
              {t('work.repository')}
            </a>
          )
        }
      </div>
      {
        entry.data.thumbnail && (
          <Image
            class="article-image"
            src={entry.data.thumbnail}
            alt={entry.data.title}
            widths={[720, 1040, 1400]}
            sizes="(min-width: 900px) 72rem, 100vw"
            loading="eager"
          />
        )
      }
    </header>

    <div class="section article-layout">
      <aside class="article-toc">
        <p class="eyebrow">{t('work.stackEyebrow')}</p>
        <ul class="tech-list">
          {
            entry.data.tech.map((item) => (
              <li>
                <a href={withBase(`/tech/${item.toLowerCase()}/`)}>{item}</a>
              </li>
            ))
          }
        </ul>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
