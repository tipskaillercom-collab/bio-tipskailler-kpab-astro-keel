        }
      })();
    </script>
  </section> -->
  <section class="section search-section" aria-label={t('search.sectionLabel')}>
    <div id="search" data-bundle-path={bundlePath} data-locale={locale}>
      <p class="search-fallback" set:html={t('search.fallback')} />
    </div>
    <script is:inline data-astro-rerun>
      (() => {
        const container = document.getElementById('search');
        if (!container) return;

        // Hủy instance cũ nếu vừa chuyển trang qua View Transitions
        if (window.__pagefindInstance) {
          window.__pagefindInstance.destroy();
          window.__pagefindInstance = null;
        }

        const bundlePath = container.dataset.bundlePath;
        const language = container.dataset.locale || document.documentElement.lang;

        const initSearch = () => {
          container.querySelector('.search-fallback')?.remove();
          window.__pagefindInstance = new PagefindUI({
            element: '#search',
            bundlePath,
            language,
            showImages: false,
            showSubResults: true,
            autofocus: true,
          });
        };

        if (window.PagefindUI) {
          initSearch();
        } else {
          const script = document.createElement('script');
          script.src = `${bundlePath}pagefind-ui.js`;
          script.onload = initSearch;
          document.head.append(script);
        }
      })();
    </script>
  </section>
</BaseLayout>
