---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BlogTagView from '../../../../components/BlogTagView.astro';
import { locale as defaultLocale } from '../../../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (
    await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith(`${defaultLocale}/`))
  ).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return allTags.flatMap((tag) => {
    const taggedPosts = posts.filter((post) => post.data.tags.includes(tag));
    const otherTags = allTags.filter((item) => item !== tag).sort((a, b) => a.localeCompare(b));

    return paginate(taggedPosts, {
      params: { tag },
      pageSize: 10,
      props: { otherTags },
    });
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.params;
const { page, otherTags } = Astro.props;
---

<BlogTagView locale={defaultLocale} tag={tag} page={page} otherTags={otherTags} />
