---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { useWithBaseWithLocale } from '../../lib/url';
import { getSiteConfig } from '../../consts';
import { type Locale, locale as defaultLocale, useTranslations } from '../../i18n';
import { toCollectionSlug } from '../../helpers/commons';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (
    await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith(`${defaultLocale}/`))
  ).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
    a.localeCompare(b),
  );

  return paginate(posts, {
    pageSize: 10,
    props: { locale: defaultLocale, allTags },
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, allTags, locale: propLocale } = Astro.props;
const locale = (propLocale ?? Astro.params.locale ?? defaultLocale) as Locale;

const { formatDate, readingTime, t } = useTranslations(locale);
const SITE = getSiteConfig(locale);
const { withBase } = useWithBaseWithLocale(locale);

const posts = page.data;

const readingTimes = new Map(
  await Promise.all(
    posts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return [post.id, readingTime(remarkPluginFrontmatter.minutesRead)] as const;
    }),
  ),
);

const pageTitle =
  page.currentPage === 1 ? t('blog.title') : t('blog.titlePaged', { page: page.currentPage });

const getPostHref = (postId: string) => {
  const cleanSlug = toCollectionSlug(postId, locale);
  return withBase(`/${locale}/blog/${cleanSlug}/`);
};
---

<BaseLayout
  title={pageTitle}
  description={t('blog.pageDescription', { title: SITE.title })}
  ogType="website"
  image={withBase('/og/blog/index.png')}
>
  <section class="page-head section">
    <p class="eyebrow">{t('blog.eyebrow')}</p>
    <h1>Notes, essays, and release logs.</h1>
    <p class="lead">
      The blog collection supports tags, descriptions, draft filtering, publish dates, and optional
      hero images.
    </p>
  </section>

  <section class="section content-index" aria-label={t('blog.listLabel')}>
    <div class="index-sidebar">
      <p class="eyebrow">{t('blog.tagsEyebrow')}</p>
      <nav class="tag-cloud" aria-label={t('blog.tagsNavLabel')}>
        {allTags.map((tag) => (
          <a href={withBase(`/${locale}/blog/tags/${tag}/`)}>{tag}</a>
        ))}
      </nav>
    </div>

    <div>
      <div class="entry-list">
        {posts.map((post) => (
          <article class="entry-card">
            <div class="entry-meta">
              <time datetime={post.data.publishDate.toISOString()}>
                {formatDate(post.data.publishDate, 'short')}
              </time>
              <span>{readingTimes.get(post.id)}</span>
              <span>{post.data.tags.join(' / ')}</span>
            </div>
            <h2>
              <a href={getPostHref(post.id)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>
