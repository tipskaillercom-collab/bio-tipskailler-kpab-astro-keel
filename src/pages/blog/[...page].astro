---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BlogListPage from '../../components/pages/blog/BlogListPage.astro';
import { locale as defaultLocale } from '../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
    a.localeCompare(b),
  );

  return paginate(posts, { pageSize: 10, props: { allTags, locale: defaultLocale } });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, allTags, locale } = Astro.props;
---

<BlogListPage page={page} allTags={allTags} locale={locale} />
