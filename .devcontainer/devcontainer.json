{
  "name": "Astro Dev Environment (Node 24)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bullseye",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode", // recommendations: Language support for Astro
        "dbaeumer.vscode-eslint", // Tìm và fix với ngôn ngữ Javascript
        "esbenp.prettier-vscode", // recommendations: Format code với prettier
        "editorconfig.editorconfig", // Đề xuất loại ngôn ngữ phù hợp với 1 tab file được tạo mới dựa trên nội dung ngôn ngữ đó
        "bradlc.vscode-tailwindcss", // Công cụ gợi ý code dành cho Tailwind CSS
        "naumovs.color-highlight", // Tô màu dòng code màu của css
        "daanrosendal.pinboard", // Pin files
        "ryu1kn.partial-diff", // So sánh file
        "funkyremi.vscode-google-translate", // Dịch ra ngôn ngữ mong muốn, dùng: ALT + SHIFT + T
        "github.vscode-github-actions", // Action Github
        "continue.continue", // Continue
        "gruntfuggly.todo-tree", // Nhắc nhở việc làm
        "tctinh.universal-agent-quota-tracker", // Thống kê số lượng token còn lại của AI
        "thewalking-dev.ai-insights", // Thống kê số lượng token còn lại của AI
        "redhat.vscode-yaml", // Dành cho Yaml
        "ms-playwright.playwright" // Tự động hóa kiểm thử (E2E Test)
      ],
      "settings": {}
    }
  },
  "containerEnv": {
    // Sử dụng cú pháp ${localEnv:TEN_BIEN} để lấy giá trị từ máy host
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}"
  },
  "remoteUser": "node",
  "forwardPorts": [4321],
  "postCreateCommand": "sudo apt update && sudo apt install -y ripgrep curl && curl -LsSf https://aider.chat/install.sh | sh && echo 'alias dev=\"npm run dev -- --host\"' >> ~/.bashrc && echo 'alias preview=\"npm run preview -- --host\"' >> ~/.bashrc && echo 'alias format=\"npm run format\"' >> ~/.bashrc && echo 'alias check=\"npm run check\"' >> ~/.bashrc && echo 'alias build-all=\"npm run build && npm run postbuild\"' >> ~/.bashrc"
}
